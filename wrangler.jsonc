/**
 * ============================================================================
 *  Cloudflare Workers — configuración de PRODUCCIÓN
 * ============================================================================
 *  Un solo Worker sirve la app estática (public/) y la API (/api/*).
 *
 *  Despliegue:
 *     npx wrangler login
 *     npm run db:create                  # imprime el database_id → pégalo abajo
 *     npm run db:remote                  # aplica schema.sql en la D1 de producción
 *     npx wrangler secret put ADMIN_PASSWORD   (y ADMIN_SECRET)
 *     npm run deploy                     # wrangler deploy
 *
 *  Local:
 *     npm run db:local                   # esquema en la D1 simulada (SQLite)
 *     npm run dev                        # http://localhost:8788  ·  /admin
 *
 *  Notas:
 *   · `run_worker_first: ["/api/*"]` ⇒ solo la API invoca al Worker; el resto
 *     de rutas se sirven como assets del CDN (sin coste de invocación).
 *   · `_headers` y `_redirects` SÍ funcionan en Workers static assets.
 *   · `_routes.json` era de Pages: aquí se sustituye por run_worker_first.
 *   · No se usa `nodejs_compat`: el backend solo emplea fetch y Web Crypto.
 * ============================================================================
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amigosecreto",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amigosecreto",
      "database_id": "b7892864-e905-424a-b7b3-dc31f1f40053"
    }
  ],
  "observability": {
    "enabled": true
  }
}
