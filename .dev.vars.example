# Amigo Secreto — variables de entorno (LOCAL)
# Copia este archivo a .dev.vars para `wrangler dev` (Workers + D1 local).
# .dev.vars está en .gitignore: NUNCA se sube al repositorio.

# --- Panel de administración (/admin) ---
# ADMIN_PASSWORD es la contraseña que escribirás en el panel.
ADMIN_PASSWORD="cambia-esta-contraseña"
# ADMIN_SECRET firma las cookies (admin y sesión del jugador). Cadena larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# --- Opcionales ---
# ROOM_ID="main"        # id de la sala única
# ROOM_TTL_HOURS="12"   # horas tras las que se purga a quien no vuelve (12 = más que cualquier fiesta)

# --- Control de frecuencia (y por tanto de filas escritas en D1) ---
# TICK_MS="2000"        # latido del jugador (1000–15000 ms)
# ADMIN_TICK_MS="3000"  # refresco del panel (1000–15000 ms)
# HEARTBEAT_MS="10000"  # cada cuánto se escribe de verdad el latido (2000–60000 ms)

# --- Solo para PRUEBAS locales ---
# DEBUG_USAGE="1"       # expone /api/admin/usage con filas leídas/escritas de D1
#                       # (lo usa tools/load-test.mjs; no definir en producción)

# NOTA: la base de datos ya no necesita credenciales: es el binding D1 "DB" de
# wrangler.jsonc. En local se simula con SQLite (npx wrangler d1 execute … --local).

