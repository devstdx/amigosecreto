{
  "name": "amigosecreto",
  "version": "1.0.0",
  "private": true,
  "description": "Amigo Secreto en vivo: sala única, panel de administración y despliegue en Cloudflare Pages",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "dev:workers": "wrangler dev --port 8788",
    "deploy": "wrangler pages deploy public",
    "deploy:workers": "wrangler deploy",
    "db:create": "wrangler d1 create amigosecreto --location weur",
    "db:configure": "node tools/d1-configure.mjs",
    "db:ensure": "node tools/d1-ensure.mjs",
    "db:local": "wrangler d1 execute amigosecreto --local --file=schema.sql",
    "db:remote": "wrangler d1 execute amigosecreto --remote --file=schema.sql",
    "secrets": "wrangler pages secret bulk",
    "secrets:workers": "wrangler secret bulk",
    "test": "bash tools/smoke-test.sh && bash tools/edge-test.sh",
    "test:load": "node tools/load-test.mjs",
    "test:failures": "bash tools/failure-test.sh",
    "check:ids": "node tools/check-ids.mjs",
    "verify": "npm run typecheck && npm run check:ids && npm test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.0"
  }
}

